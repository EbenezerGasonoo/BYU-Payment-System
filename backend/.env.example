# Server Configuration
PORT=3000

# Supabase PostgreSQL (recommended)
# Project Settings → Database → Connection string → URI (Session mode for Railway)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Or use individual fields instead of DATABASE_URL:
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_NAME=postgres

# Set DB_SSL=false only for local Postgres without TLS
# DB_SSL=true

# Email Configuration (Gmail)
# Option A (recommended, works on any Railway plan): Brevo HTTPS API
# BREVO_API_KEY from Brevo → SMTP & API → API Keys; EMAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=xkeysib-your-key-here
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=ConnectPay

# Option B: SMTP (blocked on Railway's non-Pro plans). Used only when BREVO_API_KEY is not set.
# Set EMAIL_SERVICE=gmail (with a Gmail app password), or EMAIL_HOST/EMAIL_PORT for another server.
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# EMAIL_SERVICE=gmail
ADMIN_EMAIL=admin@example.com

# Admin Authentication
ADMIN_KEY=your-secret-admin-key-here

# Signs student session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_TOKEN_SECRET=your-long-random-secret-here

# Set to true ONLY for local testing: lets Paystack payments be approved without a real Paystack key
PAYMENT_SIMULATION=false

# Set to true ONLY for local testing: lets the backend generate FAKE card numbers
# (automatic fallback after payment, and the admin "Mock" button). Leave false in production
# so paid requests without a live card provider stay pending for an admin to assign a real card.
CARD_SIMULATION=false

# Virtual card issuing providers (optional; leave unset if cards are assigned manually)
# SUDO_API_KEY=
# SUDO_ENV=sandbox
# MAPLERAD_SECRET_KEY=
# MAPLERAD_BASE_URL=https://sandbox.api.maplerad.com

# Hubtel Direct Debit API Configuration  
# Get these from: https://app.hubtel.com/settings/api-keys
HUBTEL_API_KEY=your_hubtel_client_secret_here
HUBTEL_API_ID=your_hubtel_client_id_here
HUBTEL_POS_SALES_ID=your_pos_sales_id_here
HUBTEL_CHARGE_URL=https://rmp.hubtel.com/merchantaccount
HUBTEL_PREAPPROVAL_URL=https://preapproval.hubtel.com/api/v2

# MTN MoMo API Configuration
# Get these from: https://momodeveloper.mtn.com
# 1. Register and create subscription to "Collection" product
# 2. Generate API user and API key
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_COLLECTION_SUBSCRIPTION_KEY=your_mtn_subscription_key_here
MTN_API_USER=your_mtn_api_user_uuid_here
MTN_API_KEY=your_mtn_api_key_here
MTN_TARGET_ENVIRONMENT=sandbox
# For production, change to:
# MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MTN_TARGET_ENVIRONMENT=mtnghana

# Optional: Set these to customize URLs
# API_URL=https://your-backend-url.com
# FRONTEND_URL=https://your-frontend-url.com

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" in your Google Account settings
# 3. Use the app password (not your regular Gmail password)

